# Local Docker Compose uses its own disposable Postgres credentials.
DATABASE_URL=postgresql://evidenceflow:evidenceflow@127.0.0.1:5432/evidenceflow
APP_ORIGIN=http://localhost:8080
# EVIDENCEFLOW_PORT=8765
COOKIE_SECURE=false
STORAGE_BACKEND=local
STORAGE_DIR=./data/objects
WORKER_ENABLED=true

# Optional. Enable only for documents cleared for external processing.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest
HF_ALLOW_EVIDENCE=false

# Set STORAGE_BACKEND=s3 for hosted deployments.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
